[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/components/import_page.gd" id="1"]

[node name="ImportPage" type="MarginContainer"]
unique_name_in_owner = true
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="Root" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="Scroll/Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scroll/Root/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "📥 IMPORT / RESTORE"

[node name="CloseButton" type="Button" parent="Scroll/Root/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
text = "✕ Close"

[node name="InfoLabel" type="Label" parent="Scroll/Root"]
layout_mode = 2
autowrap_mode = 2
text = "Choose a NeonNotes backup to restore, or a folder / archive of Markdown files to import."

[node name="Buttons" type="HBoxContainer" parent="Scroll/Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ChooseZipButton" type="Button" parent="Scroll/Root/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Choose file…"

[node name="ChooseFolderButton" type="Button" parent="Scroll/Root/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Choose folder…"

[node name="ProgressBar" type="ProgressBar" parent="Scroll/Root"]
unique_name_in_owner = true
visible = false
layout_mode = 2
min_value = 0.0
max_value = 1.0

[node name="StatusLabel" type="Label" parent="Scroll/Root"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="ReportLabel" type="Label" parent="Scroll/Root"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="Actions" type="VBoxContainer" parent="Scroll/Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ReplaceButton" type="Button" parent="Scroll/Root/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
text = "Replace current vault"

[node name="NewVaultButton" type="Button" parent="Scroll/Root/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
text = "Create new vault…"

[node name="CancelActionButton" type="Button" parent="Scroll/Root/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Cancel"
