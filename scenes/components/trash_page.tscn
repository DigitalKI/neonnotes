[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/components/trash_page.gd" id="1_trash"]

[node name="TrashPage" type="MarginContainer"]
unique_name_in_owner = true
visible = false
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10
script = ExtResource("1_trash")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Root/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "🗑 TRASH"

[node name="CloseButton" type="Button" parent="Root/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
text = "✕ Close"

[node name="Hint" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
text = "Items are kept for 30 days, then removed automatically."
autowrap_mode = 2

[node name="TrashList" type="ItemList" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
allow_reselect = true

[node name="ButtonRow" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RestoreBtn" type="Button" parent="Root/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "↩ Restore"

[node name="PurgeBtn" type="Button" parent="Root/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "🔥 Delete Forever"

[node name="EmptyBtn" type="Button" parent="Root/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Empty Trash"
