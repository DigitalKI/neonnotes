[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/components/selection_overlay.gd" id="1_sel"]

[node name="SelectionOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_sel")

[node name="HandleStart" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 44)
layout_mode = 0
mouse_filter = 0

[node name="HandleEnd" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 44)
layout_mode = 0
mouse_filter = 0

[node name="ActionBar" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 0
mouse_filter = 0
theme_override_constants/separation = 6

[node name="CutBtn" type="Button" parent="ActionBar"]
layout_mode = 2
focus_mode = 0
text = "Cut"

[node name="CopyBtn" type="Button" parent="ActionBar"]
layout_mode = 2
focus_mode = 0
text = "Copy"

[node name="PasteBtn" type="Button" parent="ActionBar"]
layout_mode = 2
focus_mode = 0
text = "Paste"

[connection signal="pressed" from="ActionBar/CutBtn" to="." method="_on_action_pressed" binds=["cut"]]

[connection signal="pressed" from="ActionBar/CopyBtn" to="." method="_on_action_pressed" binds=["copy"]]

[connection signal="pressed" from="ActionBar/PasteBtn" to="." method="_on_action_pressed" binds=["paste"]]
