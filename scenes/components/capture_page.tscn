[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/components/capture_page.gd" id="1_cap"]

[node name="CapturePage" type="MarginContainer"]
unique_name_in_owner = true
visible = false
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10
script = ExtResource("1_cap")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Root/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "📥 CAPTURE TO INBOX"

[node name="CloseButton" type="Button" parent="Root/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
text = "✕ Close"

[node name="NameField" type="LineEdit" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "title (optional)"
autocorrect = false

[node name="CaptureField" type="TextEdit" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
placeholder_text = "Paste a link, or type anything…"
wrap_mode = 1
autocorrect = false

[node name="Hint" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
text = "Saved to Inbox/. Drag it out of Inbox to file it."

[node name="ButtonRow" type="HBoxContainer" parent="Root"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 8

[node name="PasteBtn" type="Button" parent="Root/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
text = "📋 Paste"

[node name="ImageBtn" type="Button" parent="Root/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
text = "🖼 Image…"

[node name="CaptureBtn" type="Button" parent="Root/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
text = "✓ Capture"
