[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/sync/sync_page.gd" id="1"]

[node name="SyncPage" type="MarginContainer"]
unique_name_in_owner = true
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="Root" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="Scroll/Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scroll/Root/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "⇄ LAN SYNC"

[node name="CloseButton" type="Button" parent="Scroll/Root/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
text = "✕ Close"

[node name="DeviceLabel" type="Label" parent="Scroll/Root"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="PinLabel" type="Label" parent="Scroll/Root"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
theme_override_font_sizes/font_size = 14

[node name="Columns" type="VBoxContainer" parent="Scroll/Root"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="DiscoveryToggle" type="Button" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
text = "Start Discovery"

[node name="PeerList" type="ItemList" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 140)
layout_mode = 2
size_flags_vertical = 3

[node name="PinEdit" type="LineEdit" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Remote vault pairing words (first time only)"

[node name="SendBtn" type="Button" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
layout_mode = 2
text = "Pair / Sync → Vault"

[node name="UnpairBtn" type="Button" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
layout_mode = 2
text = "Unpair this vault"

[node name="ResetBtn" type="Button" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
layout_mode = 2
text = "↺ Reset pairing words…"

[node name="SyncLog" type="RichTextLabel" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true

[node name="StatusLabel" type="Label" parent="Scroll/Root/Columns"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
