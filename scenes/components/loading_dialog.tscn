[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/components/loading_dialog.gd" id="1_load"]

[node name="LoadingDialog" type="AcceptDialog"]
initial_position = 1
script = ExtResource("1_load")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MessageLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Please wait…"

[node name="ProgressBar" type="ProgressBar" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
min_value = 0.0
max_value = 1.0
indeterminate = true

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
modulate = Color(0.6, 0.6, 0.6, 1)
text = "Rendering and encoding…"
