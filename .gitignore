# Godot 4
.godot/
*.translation

# Builds
build/
export/
# ...but `export/` above also matches the engine-side source directory
# scripts/export/ (Exporter/GifWriter/HtmlExporter/OutboundShare) — re-include
# it so a fresh clone can compile.
!scripts/export/

# Godot's Android build template is machine-local (android/build/ is already
# covered by the build/ rule above); ignore the generated marker too.
android/.build_version
*.apk
*.aab
*.idsig
*.exe
*.x86_64
*.pck
*.zip

# Exports / credentials
export_presets.cfg.bak
*.keystore
*.jks
*.pem

# System / editor
*.tmp
.DS_Store
Thumbs.db
